# Copy this to .env for local development
# In Fly.io, set these with: fly secrets set KEY=value

# From api.slack.com/apps — Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-token-here

# From api.slack.com/apps — App-Level Token (starts with xapp-)
# Needed for Socket Mode. Create under "Basic Information > App-Level Tokens"
# with the connections:write scope
SLACK_APP_TOKEN=xapp-your-token-here

# From console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub personal access token
# Create at: github.com/settings/tokens — needs "repo" scope for private repos
GITHUB_TOKEN=your_github_token_here

# Your project repo in "owner/repo" format
GITHUB_REPO=yourname/your-project-repo
